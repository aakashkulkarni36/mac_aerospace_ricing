#!/usr/bin/env bash

# When 3 windows are present on a workspace, arrange them as:
# Left half: Master window (full height)
# Right half: 2 stacked windows (top and bottom)

WS="${1:-$(aerospace list-workspaces --focused 2>/dev/null || echo 1)}"

# Get list of window IDs on this workspace
WINS=($(aerospace list-windows --workspace "$WS" --format "%{window-id}"))
COUNT=${#WINS[@]}

if [ "$COUNT" -eq 3 ]; then
  W1="${WINS[0]}"
  W2="${WINS[1]}"
  W3="${WINS[2]}"

  # 1. Reset any deep nested containers
  aerospace flatten-workspace-tree --workspace "$WS" 2>/dev/null

  # 2. Put workspace into horizontal row layout
  aerospace focus --window-id "$W1" 2>/dev/null
  aerospace layout --window-id "$W1" horizontal 2>/dev/null

  # 3. Stack W3 under W2 (the right column)
  aerospace focus --window-id "$W3" 2>/dev/null
  aerospace join-with --window-id "$W3" down 2>/dev/null || true

  # 4. Return focus to W1 and balance sizes evenly (50% left, 50% right split)
  aerospace focus --window-id "$W1" 2>/dev/null
  aerospace balance-sizes 2>/dev/null
elif [ "$COUNT" -eq 2 ]; then
  aerospace flatten-workspace-tree --workspace "$WS" 2>/dev/null
  aerospace focus --window-id "${WINS[0]}" 2>/dev/null
  aerospace layout --window-id "${WINS[0]}" horizontal 2>/dev/null
  aerospace balance-sizes 2>/dev/null
fi
