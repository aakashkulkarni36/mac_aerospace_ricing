#!/usr/bin/env bash

# ==============================================================================
# Smart Master & Dual-Orientation Toggle (Alt + ,)
# Handles 1 window, 2 windows, and 3 windows.
#
# For 3 windows:
#   Mode 1 (Left Master): Left 1/2 (1 app full height) + Right 1/2 (2 apps stacked up & down)
#   Mode 2 (Top Master):  Top 1/2 (1 app full width) + Bottom 1/2 (2 apps side-by-side left & right)
#   Mode 3 (3 Columns):   3 vertical side-by-side columns
# ==============================================================================

WS="$(aerospace list-workspaces --focused 2>/dev/null || echo 1)"
ORIGINAL_FOCUS="$(aerospace list-windows --focused --format "%{window-id}" 2>/dev/null)"

# 1. Unfloat any floating window on this workspace
aerospace list-windows --workspace "$WS" --format "%{window-id}|%{window-layout}" 2>/dev/null | while IFS='|' read -r wid layout; do
  wid="$(echo "$wid" | tr -d ' ')"
  layout="$(echo "$layout" | tr -d ' ')"
  if [ -n "$wid" ] && [ "$layout" = "floating" ]; then
    aerospace layout --window-id "$wid" tiling 2>/dev/null
  fi
done

# Collect window IDs
WINS=()
while IFS= read -r line; do
  [ -n "$line" ] && WINS+=("$line")
done < <(aerospace list-windows --workspace "$WS" --format "%{window-id}" 2>/dev/null)

COUNT=${#WINS[@]}

if [ "$COUNT" -le 1 ]; then
  exit 0
fi

STATE_FILE="/tmp/aerospace_layout_state_${WS}"
PREV_STATE="0"
[ -f "$STATE_FILE" ] && PREV_STATE="$(cat "$STATE_FILE" 2>/dev/null || echo 0)"

if [ "$COUNT" -eq 2 ]; then
  ROOT_LAYOUT="$(aerospace list-windows --workspace "$WS" --format "%{workspace-root-container-layout}" 2>/dev/null | head -n1 | tr -d ' ')"
  aerospace flatten-workspace-tree --workspace "$WS" 2>/dev/null
  if [ "$ROOT_LAYOUT" = "v_tiles" ] || [ "$ROOT_LAYOUT" = "v_accordion" ]; then
    aerospace layout --workspace "$WS" --root horizontal 2>/dev/null
  else
    aerospace layout --workspace "$WS" --root vertical 2>/dev/null
  fi
  aerospace balance-sizes 2>/dev/null

elif [ "$COUNT" -eq 3 ]; then
  NEXT_STATE=$(( (PREV_STATE + 1) % 3 ))
  echo "$NEXT_STATE" > "$STATE_FILE"

  aerospace flatten-workspace-tree --workspace "$WS" 2>/dev/null

  W1="${WINS[0]}"
  W2="${WINS[1]}"
  W3="${WINS[2]}"

  if [ "$NEXT_STATE" -eq 1 ]; then
    # Mode 1: Left Master (Left half 1 app full height, Right half 2 apps stacked top and bottom)
    aerospace layout --workspace "$WS" --root horizontal 2>/dev/null
    aerospace focus --window-id "$W3" 2>/dev/null
    aerospace move down 2>/dev/null
    aerospace balance-sizes 2>/dev/null

  elif [ "$NEXT_STATE" -eq 2 ]; then
    # Mode 2: Top Master (Top half 1 app full width, Bottom half 2 apps side-by-side)
    aerospace layout --workspace "$WS" --root vertical 2>/dev/null
    aerospace focus --window-id "$W3" 2>/dev/null
    aerospace move right 2>/dev/null
    aerospace balance-sizes 2>/dev/null

  else
    # Mode 3: 3 side-by-side vertical columns
    aerospace layout --workspace "$WS" --root horizontal 2>/dev/null
    aerospace balance-sizes 2>/dev/null
  fi
fi

# Restore focus
if [ -n "$ORIGINAL_FOCUS" ]; then
  aerospace focus --window-id "$ORIGINAL_FOCUS" 2>/dev/null
fi
