#!/usr/bin/env bash

# Smart Fullscreen Toggle:
# If toggling fullscreen ON when other windows share the space:
# Moves the other windows to an adjacent overflow space so the focused window has the entire screen without hidden background clutter.
# When fullscreen is toggled OFF, restores the stashed windows back to the original workspace.

FOCUSED_WIN=$(aerospace list-windows --focused --format "%{window-id}" 2>/dev/null)
CURRENT_WS=$(aerospace list-workspaces --focused 2>/dev/null || echo 1)
STASH_FILE="/tmp/aerospace_stash_${CURRENT_WS}.txt"

if [ -f "$STASH_FILE" ]; then
  # Fullscreen is currently active with stashed windows -> toggle fullscreen off and bring windows back
  aerospace fullscreen
  while IFS= read -r wid; do
    [ -n "$wid" ] && aerospace move-node-to-workspace --window-id "$wid" "$CURRENT_WS" 2>/dev/null
  done < "$STASH_FILE"
  rm -f "$STASH_FILE"
  sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$CURRENT_WS" 2>/dev/null
  exit 0
fi

# Not currently stashed: check how many windows are in this workspace
ALL_WINS=$(aerospace list-windows --workspace "$CURRENT_WS" --format "%{window-id}")
WIN_COUNT=$(echo "$ALL_WINS" | grep -v '^$' | wc -l | tr -d ' ')

if [ "$WIN_COUNT" -gt 1 ]; then
  # Find an overflow workspace (e.g. current + 1 or next empty workspace)
  TARGET_WS=$((CURRENT_WS + 1))
  [ "$TARGET_WS" -gt 9 ] && TARGET_WS=9

  > "$STASH_FILE"
  for wid in $ALL_WINS; do
    if [ "$wid" != "$FOCUSED_WIN" ]; then
      echo "$wid" >> "$STASH_FILE"
      aerospace move-node-to-workspace --window-id "$wid" "$TARGET_WS" 2>/dev/null
    fi
  done
  aerospace fullscreen
  sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$CURRENT_WS" 2>/dev/null
else
  # Single window: normal fullscreen toggle
  aerospace fullscreen
fi
