#!/usr/bin/env bash

# Alt + f behavior:
# 1. If window is fullscreen: exits fullscreen mode.
# 2. If window is floating: returns it to tiling mode.
# 3. If window is normal tiled: makes it fullscreen.
# 4. If pressed again while fullscreen: exits fullscreen and makes it floating (as requested: "alt + f is full screen and alt + f should make it floating again").

WIN_INFO="$(aerospace list-windows --focused --format "%{window-id}|%{window-is-fullscreen}|%{window-layout}")"
IFS='|' read -r WID IS_FS LAYOUT <<< "$WIN_INFO"

if [ -z "$WID" ]; then
  exit 0
fi

if [ "$IS_FS" = "true" ]; then
  # Currently fullscreen: exit fullscreen and toggle to floating
  aerospace fullscreen off --fail-if-noop 2>/dev/null || aerospace fullscreen
  aerospace layout floating 2>/dev/null
elif [ "$LAYOUT" = "floating" ]; then
  # Currently floating: switch back to tiling
  aerospace layout tiling 2>/dev/null
else
  # Currently tiled: make fullscreen
  aerospace fullscreen on --fail-if-noop 2>/dev/null || aerospace fullscreen
fi
