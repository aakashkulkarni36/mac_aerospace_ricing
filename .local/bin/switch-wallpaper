#!/usr/bin/env bash
# ==============================================================================
# Dynamic Wallpaper Switcher & Theme Harmonizer for macOS Rice
# Switches macOS desktop wallpaper, SketchyBar glass palette, JankyBorders,
# and VS Code translucent background & accents synchronously.
# ==============================================================================

set -e

# Wallpaper Database Definition
# Index | Slug | WallhavenID | Title | Artist | File | Hex1 | Hex2 | ARGB1 | ARGB2 | TileBG | TileBorder | ItemHL | CardBG | CardBorder | BorderGradient | WS_BG | WS_Border
WP_LIST=(
  "1|meadow|5y3571|Meadow Vista|Stefan Hansson|$HOME/Pictures/Wallpapers/wallhaven-5y3571.jpg|#38bdf8|#06b6d4|0xff38bdf8|0xff06b6d4|0xc21e2d36|0x3874c7ec|0x3538bdf8|0xd818252d|0x4538bdf8|gradient(top_left=0xff38bdf8,bottom_right=0xff06b6d4)|0x4038bdf8|0x8038bdf8"
  "2|highway|wekp5x|Golden Highway|Guillem H. Pongiluppi|$HOME/Pictures/Wallpapers/wallhaven-wekp5x.jpg|#f59e0b|#ea580c|0xfff59e0b|0xffea580c|0xc22b2219|0x38f59e0b|0x35f59e0b|0xd8241c14|0x45f59e0b|gradient(top_left=0xfffbbf24,bottom_right=0xffea580c)|0x40f59e0b|0x80f59e0b"
  "3|horizon|lm1z2l|Twilight Horizon|Simon Stålenhag|$HOME/Pictures/Wallpapers/wallhaven-lm1z2l.jpg|#818cf8|#38bdf8|0xff818cf8|0xff38bdf8|0xc21f1e33|0x38818cf8|0x35818cf8|0xd81b1a2c|0x45818cf8|gradient(top_left=0xff818cf8,bottom_right=0xff38bdf8)|0x40818cf8|0x80818cf8"
)

TOTAL_WP=${#WP_LIST[@]}

get_active_wallpaper_path() {
  local wp_path=""
  if [ -x "$HOME/.local/bin/macos-wallpaper" ]; then
    wp_path=$("$HOME/.local/bin/macos-wallpaper" get 2>/dev/null || true)
  fi
  if [ -z "$wp_path" ] && [ -f "$HOME/.config/sketchybar/current_theme.sh" ]; then
    wp_path=$(grep 'export THEME_WALLPAPER=' "$HOME/.config/sketchybar/current_theme.sh" 2>/dev/null | cut -d'"' -f2)
  fi
  echo "$wp_path"
}

get_active_index() {
  local active_path
  active_path=$(get_active_wallpaper_path)
  local i=1
  for entry in "${WP_LIST[@]}"; do
    IFS='|' read -r idx slug id title artist file rest <<< "$entry"
    expanded_file="${file/\$HOME/$HOME}"
    if [ "$expanded_file" = "$active_path" ] || [ "$(basename "$expanded_file")" = "$(basename "$active_path")" ]; then
      echo "$idx"
      return 0
    fi
    ((i++))
  done
  echo "1"
}

apply_wallpaper() {
  local target_idx="$1"
  local selected_entry=""
  
  for entry in "${WP_LIST[@]}"; do
    IFS='|' read -r idx slug id title artist file hex1 hex2 argb1 argb2 tile_bg tile_border item_hl card_bg card_border border_grad ws_bg ws_border <<< "$entry"
    if [ "$idx" = "$target_idx" ] || [ "$slug" = "$target_idx" ] || [ "$id" = "$target_idx" ]; then
      selected_entry="$entry"
      break
    fi
  done

  if [ -z "$selected_entry" ]; then
    echo "❌ Unknown wallpaper option: $target_idx"
    echo "Available options: 1 (meadow), 2 (highway), 3 (horizon)"
    exit 1
  fi

  IFS='|' read -r idx slug id title artist file hex1 hex2 argb1 argb2 tile_bg tile_border item_hl card_bg card_border border_grad ws_bg ws_border <<< "$selected_entry"
  local expanded_file="${file/\$HOME/$HOME}"

  # 1. Set macOS Desktop Wallpaper
  if [ -x "$HOME/.local/bin/macos-wallpaper" ]; then
    "$HOME/.local/bin/macos-wallpaper" "$expanded_file" >/dev/null 2>&1 || true
  fi

  # 2. Write SketchyBar current_theme.sh
  cat << EOF > "$HOME/.config/sketchybar/current_theme.sh"
#!/usr/bin/env bash
# Auto-generated by switch-wallpaper - DO NOT EDIT MANUALLY
export THEME_INDEX="$idx"
export THEME_SLUG="$slug"
export THEME_WALLHAVEN_ID="$id"
export THEME_NAME="$title ($artist)"
export THEME_WALLPAPER="$expanded_file"
export THEME_HEX_ACCENT1="$hex1"
export THEME_HEX_ACCENT2="$hex2"
export THEME_ACCENT1="$argb1"
export THEME_ACCENT2="$argb2"
export THEME_TILE_BG="$tile_bg"
export THEME_TILE_BORDER="$tile_border"
export THEME_ITEM_HIGHLIGHT="$item_hl"
export THEME_CARD_BG="$card_bg"
export THEME_CARD_BORDER="$card_border"
export THEME_BORDER_GRADIENT='$border_grad'
export THEME_WS_BG="$ws_bg"
export THEME_WS_BORDER="$ws_border"
EOF
  chmod +x "$HOME/.config/sketchybar/current_theme.sh"

  # 3. Update JankyBorders
  cat << EOF > "$HOME/.config/borders/bordersrc"
#!/usr/bin/env bash
# JankyBorders - Dynamic Wallpaper Palette: $title
borders \\
    style=round \\
    width=4.5 \\
    hidpi=on \\
    active_color='$border_grad' \\
    inactive_color=0x251e293b \\
    background_color=0x200f172a
EOF
  chmod +x "$HOME/.config/borders/bordersrc"
  borders active_color="$border_grad" 2>/dev/null || true

  # 4. Reload SketchyBar
  sketchybar --reload 2>/dev/null || true

  # 5. Update VS Code Settings (Dynamic Background & Accent)
  local vscode_settings="$HOME/Library/Application Support/Code/User/settings.json"
  local repo_vscode="$HOME/projects/mac_aerospace_ricing/.config/vscode/settings.json"
  
  python3 - << PYEOF 2>/dev/null || true
import re

def update_file(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Update editor background image
        content = re.sub(
            r'file:///Users/aakashkulkarni/Pictures/Wallpapers/wallhaven-[^"\'\s]+',
            'file://$expanded_file',
            content
        )
        
        # Update colorCustomizations accents
        for key in ["tab.activeBorder", "tab.activeBorderTop", "tab.activeForeground", "focusBorder", "activityBar.activeBorder", "activityBar.foreground", "sideBarTitle.foreground"]:
            content = re.sub(
                rf'"{re.escape(key)}":\s*"#[0-9a-fA-F]+"',
                f'"{key}": "$hex1"',
                content
            )
            
        with open(path, 'w', encoding='utf-8') as f:
            f.write(content)
    except Exception:
        pass

update_file("$vscode_settings")
update_file("$repo_vscode")
PYEOF

  # 6. Display Native macOS Notification
  osascript -e "display notification \"🎨 Accent: $hex1 | Gradient: $title\" with title \"Wallpaper Switched: $title\" subtitle \"$artist\" sound name \"Glass\"" 2>/dev/null || true

  # 7. Print Formatted Terminal Status Card
  echo ""
  echo -e "\033[1;36m┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\033[0m"
  echo -e "\033[1;36m┃\033[0m  \033[1;32m✔ WALLPAPER & SYSTEM PALETTE SWITCHED\033[0m                           \033[1;36m┃\033[0m"
  echo -e "\033[1;36m┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\033[0m"
  echo -e "\033[1;36m┃\033[0m  \033[1;37mActive Image :\033[0m \033[1;33m$title\033[0m by \033[0;37m$artist\033[0m"
  echo -e "\033[1;36m┃\033[0m  \033[1;37mWallhaven ID :\033[0m \033[0;36m#$id\033[0m (\033[4;34mhttps://wallhaven.cc/w/$id\033[0m)"
  echo -e "\033[1;36m┃\033[0m  \033[1;37mLocal File   :\033[0m \033[0;37m$expanded_file\033[0m"
  echo -e "\033[1;36m┃\033[0m  \033[1;37mPrimary Color:\033[0m \033[1;35m$hex1\033[0m (RGB: $argb1)"
  echo -e "\033[1;36m┃\033[0m  \033[1;37mSecond Color :\033[0m \033[1;35m$hex2\033[0m (RGB: $argb2)"
  echo -e "\033[1;36m┃\033[0m  \033[1;37mJankyBorders :\033[0m \033[0;32m$border_grad\033[0m"
  echo -e "\033[1;36m┃\033[0m  \033[1;37mSynchronized :\033[0m macOS Desktop, SketchyBar, Borders, VS Code"
  echo -e "\033[1;36m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\033[0m"
  echo ""
}

show_status() {
  local curr_idx
  curr_idx=$(get_active_index)
  echo ""
  echo -e "\033[1;35m🎨 CURRENT WALLPAPER & THEME STATUS\033[0m"
  echo -e "\033[0;37m────────────────────────────────────────────────────────────────────\033[0m"
  
  for entry in "${WP_LIST[@]}"; do
    IFS='|' read -r idx slug id title artist file hex1 hex2 rest <<< "$entry"
    if [ "$idx" = "$curr_idx" ]; then
      echo -e "  \033[1;32m● [$idx] $title - $artist\033[0m \033[1;33m[ACTIVE]\033[0m"
      echo -e "      ↳ ID: #$id | Accents: $hex1 / $hex2 | Path: $file"
    else
      echo -e "    [$idx] $title - $artist"
      echo -e "      ↳ ID: #$id | Accents: $hex1 / $hex2"
    fi
  done
  echo -e "\033[0;37m────────────────────────────────────────────────────────────────────\033[0m"
  echo -e "Quick Switch: \033[1;36mswitch-wallpaper <1-3|next|prev|meadow|highway|horizon>\033[0m"
  echo -e "AeroSpace   : \033[1;36mAlt + W\033[0m to cycle to next wallpaper"
  echo ""
}

# Command dispatch
ACTION="${1:-menu}"

case "$ACTION" in
  status|current|show)
    show_status
    ;;
  list)
    show_status
    ;;
  next)
    curr=$(get_active_index)
    next_idx=$(( curr % TOTAL_WP + 1 ))
    apply_wallpaper "$next_idx"
    ;;
  prev)
    curr=$(get_active_index)
    prev_idx=$(( (curr - 2 + TOTAL_WP) % TOTAL_WP + 1 ))
    apply_wallpaper "$prev_idx"
    ;;
  1|2|3|meadow|highway|horizon|5y3571|wekp5x|lm1z2l)
    apply_wallpaper "$ACTION"
    ;;
  menu)
    show_status
    if [ -t 0 ]; then
      read -r -p "Select option [1-$TOTAL_WP, n(ext), p(rev), q(uit)]: " choice
      case "$choice" in
        1|2|3) apply_wallpaper "$choice" ;;
        n|next) 
          curr=$(get_active_index)
          apply_wallpaper "$(( curr % TOTAL_WP + 1 ))" 
          ;;
        p|prev)
          curr=$(get_active_index)
          apply_wallpaper "$(( (curr - 2 + TOTAL_WP) % TOTAL_WP + 1 ))" 
          ;;
        q|quit|exit|"") exit 0 ;;
        *) echo "Invalid selection"; exit 1 ;;
      esac
    fi
    ;;
  *)
    echo "Usage: switch-wallpaper [1|2|3|next|prev|status|meadow|highway|horizon]"
    exit 1
    ;;
esac
