#!/usr/bin/env bash

# Real-time event listener for AeroSpace:
# Listens to all window detections, focus changes, workspace switches, and unhiding from Dock.
# Enforces:
# 1. Strict max 3 tiled windows per workspace across all workspaces.
# 2. When 3 windows are detected on a space, automatically splits Left Half (Master) + Right Half (2 vertical Stack).
# 3. Dynamic SketchyBar updates.

pkill -f "aerospace subscribe" 2>/dev/null || true

# Track last state to avoid redundant work loops
LAST_CHECK=0

aerospace subscribe --all 2>/dev/null | while IFS= read -r line; do
  NOW=$(date +%s)
  # Debounce events occurring in rapid succession (within 200ms)
  case "$line" in
    *"window-detected"*|*"focused-workspace-changed"*|*"workspace-changed"*|*"focus-changed"*)
      FOCUSED_WS=$(aerospace list-workspaces --focused 2>/dev/null || echo 1)
      ~/.local/bin/aerospace-enforce-max-tiles "$FOCUSED_WS"
      sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$FOCUSED_WS" 2>/dev/null
      ;;
  esac
done
