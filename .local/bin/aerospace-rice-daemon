#!/usr/bin/env bash

# ==============================================================================
# Airtight Background Daemon for AeroSpace & SketchyBar
# Continuously guards:
#   1. Max 3 tiled windows per workspace (overflows 4th+ to next space immediately)
#   2. Auto-arranges 3 windows into master-stack
#   3. Real-time SketchyBar dynamic workspace synchronization
# ==============================================================================

while true; do
  FOCUSED_WS="$(aerospace list-workspaces --focused 2>/dev/null || echo 1)"
  
  # Check all non-empty workspaces
  ALL_WS="$(aerospace list-workspaces --monitor all --empty no 2>/dev/null)"
  for ws in $ALL_WS; do
    ~/.local/bin/aerospace-enforce-max-tiles "$ws" 2>/dev/null
  done

  sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$FOCUSED_WS" 2>/dev/null

  sleep 0.5
done
