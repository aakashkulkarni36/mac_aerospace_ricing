#!/usr/bin/env bash

# Strictly enforces a maximum of 3 tiled windows per workspace across all workspaces.
# Only overflows if more than 3 windows exist.
# Preserves user custom sizing and positions upon workspace switching!

TARGET_WS="${1:-$(aerospace list-workspaces --focused 2>/dev/null || echo 1)}"

# Get all tiled windows on this workspace
WINS=($(aerospace list-windows --workspace "$TARGET_WS" --format "%{window-id}"))
COUNT=${#WINS[@]}

if [ "$COUNT" -gt 3 ]; then
  # Target overflow workspace (current + 1 up to 9)
  OVERFLOW_WS=$((TARGET_WS + 1))
  [ "$OVERFLOW_WS" -gt 9 ] && OVERFLOW_WS=9

  # Move any window past the 3rd to the overflow workspace
  for ((i=3; i<COUNT; i++)); do
    extra_wid="${WINS[$i]}"
    [ -n "$extra_wid" ] && aerospace move-node-to-workspace --window-id "$extra_wid" "$OVERFLOW_WS" 2>/dev/null
  done
  
  sketchybar --trigger aerospace_workspace_change 2>/dev/null
fi
