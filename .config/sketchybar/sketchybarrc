#!/usr/bin/env bash

# ==============================================================================
# Premium Hyprland Floating Islands - Split around MacBook Air M2 Camera Notch
# Frosted Glass Aesthetic: Translucent deep-slate background (0x990f172a)
# Dynamic Weather Pill + Smart Dynamic Workspaces
# ==============================================================================
source "$HOME/.config/sketchybar/colors.sh"

export SKY_BLUE=0xff38bdf8
export DEEP_CYAN=0xff06b6d4
export TILE_BG=0x990f172a
export TILE_BORDER=0x4038bdf8
export ITEM_HIGHLIGHT=0x501e293b

sketchybar --bar hidden=off
sketchybar --remove '/.*/'

# Transparent Bar Container spanning top of screen
# padding_left=10 and padding_right=10 matches AeroSpace outer.left=10 and outer.right=10
sketchybar --bar \
  position=top \
  height=40 \
  blur_radius=0 \
  color=0x00000000 \
  border_width=0 \
  margin=0 \
  y_offset=4 \
  padding_left=10 \
  padding_right=10

# Default item typography & icon-to-label spacing
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Bold:13.5" \
  label.font="JetBrainsMono Nerd Font:SemiBold:12.5" \
  icon.color="$TEXT" \
  label.color="$TEXT" \
  icon.padding_left=8 \
  icon.padding_right=6 \
  label.padding_left=0 \
  label.padding_right=10 \
  background.height=32 \
  background.corner_radius=16

# ==============================================================================
# LEFT PILL 1: Workspaces + Focused App (Leftmost)
# ==============================================================================
# Leading inner margin so space.1 sits comfortably inside pill squircle curvature
sketchybar --add item pad_left left \
           --set pad_left width=6 icon.drawing=off label.drawing=off

for sid in 1 2 3 4 5; do
  sketchybar --add item space."$sid" left \
             --subscribe space."$sid" aerospace_workspace_change \
             --set space."$sid" \
                   label="$sid" \
                   label.font="JetBrainsMono Nerd Font:Bold:11.5" \
                   label.padding_left=6 \
                   label.padding_right=6 \
                   icon.drawing=off \
                   background.color="$ITEM_HIGHLIGHT" \
                   background.corner_radius=8 \
                   background.height=20 \
                   background.drawing=off \
                   script="$HOME/.config/sketchybar/plugins/aerospace.sh $sid" \
                   click_script="aerospace workspace $sid"
done

sketchybar --add item sep left \
           --set sep label="|" \
                     label.color="$OVERLAY0" \
                     label.padding_left=4 \
                     label.padding_right=6 \
                     icon.drawing=off

sketchybar --add item front_app left \
           --subscribe front_app front_app_switched aerospace_workspace_change \
           --set front_app \
                 icon="󱂬" \
                 icon.font="JetBrainsMono Nerd Font:Bold:13.5" \
                 icon.color="$SKY_BLUE" \
                 icon.padding_left=6 \
                 icon.padding_right=6 \
                 label.color="$TEXT" \
                 label.font="JetBrainsMono Nerd Font:SemiBold:12.5" \
                 label.padding_right=10 \
                 script='sketchybar --set $NAME label="${INFO:-$(aerospace list-windows --focused --format "%{app-name}" 2>/dev/null || echo "Desktop")}"'

sketchybar --add bracket pill_workspaces pad_left space.1 space.2 space.3 space.4 space.5 sep front_app \
           --set pill_workspaces \
                 background.color="$TILE_BG" \
                 background.border_color="$TILE_BORDER" \
                 background.border_width=1.5 \
                 background.corner_radius=20 \
                 background.height=38 \
                 background.blur_radius=30

# Spacer between left pills
sketchybar --add item spacer_left left \
           --set spacer_left width=8

# ==============================================================================
# LEFT PILL 2: Dynamic Weather & Geolocation (Celsius)
# ==============================================================================
sketchybar --add item weather left \
           --subscribe weather system_woke \
           --set weather update_freq=600 \
                         icon="󰖐" \
                         icon.color="$SKY_BLUE" \
                         icon.padding_left=10 \
                         icon.padding_right=6 \
                         label.color="$TEXT" \
                         label.padding_right=12 \
                         click_script="open 'x-apple.weather:'" \
                         script="$HOME/.config/sketchybar/plugins/weather.sh"

sketchybar --add bracket pill_weather weather \
           --set pill_weather \
                 background.color="$TILE_BG" \
                 background.border_color="$TILE_BORDER" \
                 background.border_width=1.5 \
                 background.corner_radius=20 \
                 background.height=38 \
                 background.blur_radius=30

# ==============================================================================
# RIGHT PILL 1: Clock & Battery (Primary Status Pill)
# ==============================================================================
sketchybar --add item clock right \
           --set clock update_freq=10 \
                       icon="󱑎" \
                       icon.color="$SKY_BLUE" \
                       icon.padding_left=8 \
                       icon.padding_right=6 \
                       label.padding_right=12 \
                       click_script="open -a Calendar" \
                       script="$HOME/.config/sketchybar/plugins/clock.sh"

sketchybar --add item battery right \
           --subscribe battery power_source_change system_woke \
           --set battery update_freq=60 \
                         icon.color="$GREEN" \
                         icon.padding_left=10 \
                         icon.padding_right=6 \
                         label.padding_right=10 \
                         click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
                         script="$HOME/.config/sketchybar/plugins/battery.sh"

sketchybar --add bracket pill_clock_battery battery clock \
           --set pill_clock_battery \
                 background.color="$TILE_BG" \
                 background.border_color="$TILE_BORDER" \
                 background.border_width=1.5 \
                 background.corner_radius=20 \
                 background.height=38 \
                 background.blur_radius=30

# Spacer between right pills
sketchybar --add item spacer1 right \
           --set spacer1 width=8

# ==============================================================================
# RIGHT PILL 2: Network & Audio (Connectivity Pill)
# ==============================================================================
sketchybar --add item volume right \
           --subscribe volume volume_change \
           --set volume icon.color="$YELLOW" \
                        icon.padding_left=10 \
                        icon.padding_right=6 \
                        label.padding_right=12 \
                        click_script="osascript -e 'set volume output muted not (output muted of (get volume settings))' && sketchybar --trigger volume_change" \
                        script="$HOME/.config/sketchybar/plugins/volume.sh"

sketchybar --add item wifi right \
           --set wifi update_freq=20 \
                      icon.color="$DEEP_CYAN" \
                      icon.padding_left=10 \
                      icon.padding_right=6 \
                      label.padding_right=10 \
                      click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
                      script="$HOME/.config/sketchybar/plugins/wifi.sh"

sketchybar --add bracket pill_network_audio wifi volume \
           --set pill_network_audio \
                 background.color="$TILE_BG" \
                 background.border_color="$TILE_BORDER" \
                 background.border_width=1.5 \
                 background.corner_radius=20 \
                 background.height=38 \
                 background.blur_radius=30

# Spacer between right pills
sketchybar --add item spacer2 right \
           --set spacer2 width=8

# ==============================================================================
# RIGHT PILL 3: Hardware Metrics (CPU & RAM Performance Pill)
# ==============================================================================
sketchybar --add item ram right \
           --set ram update_freq=15 \
                     icon.color="$MAROON" \
                     icon.padding_left=8 \
                     icon.padding_right=6 \
                     label.padding_right=12 \
                     click_script="open -a 'Activity Monitor'" \
                     script="$HOME/.config/sketchybar/plugins/ram.sh"

sketchybar --add item cpu right \
           --set cpu update_freq=10 \
                     icon.color="$PEACH" \
                     icon.padding_left=10 \
                     icon.padding_right=6 \
                     label.padding_right=10 \
                     click_script="open -a 'Activity Monitor'" \
                     script="$HOME/.config/sketchybar/plugins/cpu.sh"

sketchybar --add bracket pill_hardware cpu ram \
           --set pill_hardware \
                 background.color="$TILE_BG" \
                 background.border_color="$TILE_BORDER" \
                 background.border_width=1.5 \
                 background.corner_radius=20 \
                 background.height=38 \
                 background.blur_radius=30

# Sync bar
sketchybar --update
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused 2>/dev/null || echo 1)"
